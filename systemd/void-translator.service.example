[Unit]
Description=Void Translator Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bot
WorkingDirectory=/opt/void-translator
EnvironmentFile=/opt/void-translator/.env
ExecStart=/opt/void-translator/.venv/bin/python /opt/void-translator/main.py
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=45
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

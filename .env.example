# Copy to .env and set your real credentials locally. Never commit .env.
MANGA_BOT_TELEGRAM_BOT_TOKEN=replace_with_telegram_bot_token
# Keep the existing default path to preserve an existing manga_bot.db file.
MANGA_BOT_DATABASE_PATH=manga_bot.db
MANGA_BOT_INSTANCE_LOCK_PATH=.runtime/void_translator.lock
MANGA_BOT_AI_API_KEY=
MANGA_BOT_AI_TIMEOUT_SECONDS=60
# Stable image-capable Gemini model IDs, tried in the listed order.
MANGA_BOT_GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash
MANGA_BOT_GEMINI_MAX_RETRIES=2
MANGA_BOT_GEMINI_RETRY_DELAY_SECONDS=1.0

# Conservative resource limits for a 0.5 CPU / 512 MB RAM host
MANGA_BOT_QUEUE_MAX_SIZE=100
MANGA_BOT_AI_WORKER_COUNT=1
MANGA_BOT_DELIVERY_WORKER_COUNT=1
MANGA_BOT_THREAD_POOL_WORKERS=2
MANGA_BOT_AI_HTTP_CONNECTION_LIMIT=4
MANGA_BOT_IMAGE_MAX_SIDE=1280
MANGA_BOT_IMAGE_MAX_PIXELS=10000000
MANGA_BOT_IMAGE_MAX_DOWNLOAD_BYTES=10000000

# SQLite tuning (bounded memory + predictable lock waits)
MANGA_BOT_DB_BUSY_TIMEOUT_MS=5000
MANGA_BOT_DB_CACHE_SIZE_KIB=2048
MANGA_BOT_DB_WAL_AUTOCHECKPOINT_PAGES=1000

# Telegram delivery pacing
MANGA_BOT_TELEGRAM_SEND_BATCH_SIZE=2
MANGA_BOT_TELEGRAM_SEND_DELAY_SECONDS=0.5
